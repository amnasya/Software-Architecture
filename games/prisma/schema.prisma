generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model games {
  game_id      String @id @db.VarChar(36) @default(uuid())
  game_name    String @db.VarChar(255)
  description  String @db.VarChar(255)

  run_categories run_categories[]

  @@map("games")
}

model run_categories {
  run_category_id    String @id @db.VarChar(36) @default(uuid())
  game_id            String @db.VarChar(36)
  run_category_name  String @db.VarChar(255)

  game games @relation(fields: [game_id], references: [game_id])

  @@map("run_categories")
}